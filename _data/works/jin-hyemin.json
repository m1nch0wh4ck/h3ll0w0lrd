th: 100%; height: 100%; object-fit: cover; object-position: center;\" alt=\"진혜민 프로필\">\n      </div>\n      <!-- SNS 액션 버튼 -->\n      <div style=\"display: flex; gap: 8px; align-items: center;\">\n        <div style=\"width: 34px; height: 34px; border-radius: 50%; border: 1px solid #cfd9de; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #0f1419; cursor: pointer;\">\n          ✉️\n        </div>\n        <button style=\"background-color: #ffffff; color: #0f1419; font-weight: 700; font-size: 14px; border: 1px solid #cfd9de; padding: 7px 16px; border-radius: 20px; cursor: pointer;\">\n          팔로잉\n        </button>\n      </div>\n    </div>\n\n    <!-- 유저 이름 & ID & 계정 인증 마크 -->\n    <div style=\"margin-bottom: 12px;\">\n      <div style=\"font-size: 20px; font-weight: 800; color: #0f1419; display: flex; align-items: center; gap: 4px; line-height: 1.2;\">\n        진혜민\n        <span style=\"display: inline-flex; align-items: center; justify-content: center; width: 15px; height: 15px; background-color: #1d9bf0; color: #fff; border-radius: 50%; font-size: 9px; font-weight: 900;\">✓</span>\n      </div>\n      <div style=\"font-size: 15px; color: #536471; margin-top: 2px;\">@jhm_07</div>\n    </div>\n\n    <!-- 바이오 / 소개글 -->\n    <div style=\"font-size: 15px; line-height: 1.5; color: #0f1419; margin-bottom: 12px;\">\n      세터 · 서울 V-스타즈 No.7<br>\n      <span style=\"color: #536471; font-style: italic;\">소개글: (없음)</span>\n    </div>\n\n    <!-- 상세 프로필 속성 -->\n    <div style=\"display: flex; flex-wrap: wrap; gap: 12px; font-size: 14px; color: #536471; margin-bottom: 12px;\">\n      <span>📍 서울 장충체육관</span>\n      <span>🎈 2004년생 (23세)</span>\n      <span>📅 2020년 4월에 가입함</span>\n    </div>\n\n    <!-- 팔로워 / 팔로잉 수치 -->\n    <div style=\"display: flex; gap: 16px; font-size: 15px; color: #536471; margin-bottom: 14px;\">\n      <div><b style=\"color: #0f1419;\">3</b> <span style=\"font-size: 14px;\">팔로잉</span></div>\n      <div><b style=\"color: #0f1419;\">84.2K</b> <span style=\"font-size: 14px;\">팔로워</span></div>\n    </div>\n\n  </div>\n\n  <!-- 3. SNS 탭 메인 메뉴 -->\n  <div style=\"display: flex; border-bottom: 1px solid #eff3f4; text-align: center; font-size: 13px; font-weight: 700; color: #536471;\">\n    <div style=\"flex: 1; padding: 12px 0; color: #0f1419; border-bottom: 3px solid #1d9bf0;\">게시물</div>\n    <div style=\"flex: 1; padding: 12px 0;\">답글</div>\n    <div style=\"flex: 1; padding: 12px 0;\">미디어</div>\n    <div style=\"flex: 1; padding: 12px 0;\">마음에 들어요</div>\n  </div>\n\n  <!-- 4. 고정 트윗 (Pinned Tweet) -->\n  <div style=\"padding: 12px 16px; border-bottom: 1px solid #eff3f4; background-color: #ffffff;\">\n    <div style=\"font-size: 13px; font-weight: 700; color: #536471; margin-bottom: 8px; display: flex; align-items: center; gap: 4px;\">\n      <span>📌</span> 고정된 게시물\n    </div>\n    \n    <div style=\"display: flex; gap: 10px;\">\n      <div style=\"width: 36px; height: 36px; border-radius: 50%; background: #eff3f4; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid #eff3f4;\">\n        <img src=\"https://i.imgur.com/4YPPh6E.png\" style=\"width: 100%; height: 100%; object-fit: cover;\" alt=\"진혜민\">\n      </div>\n      <div style=\"flex: 1;\">\n        <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n          <div style=\"font-size: 14px;\">\n            <b style=\"color: #0f1419;\">진혜민</b> <span style=\"color: #536471;\">@jhm_07 · 2023년 11월 2일</span>\n          </div>\n          <span style=\"color: #536471; font-size: 14px;\">⋯</span>\n        </div>\n        <div style=\"font-size: 15px; color: #0f1419; margin: 6px 0 10px 0; line-height: 1.4;\">\n          우승했다.\n        </div>\n        <div style=\"display: flex; justify-content: space-between; max-width: 280px; font-size: 13px; color: #536471; margin-top: 8px;\">\n          <span>💬 892</span>\n          <span>🔁 1.8만</span>\n        